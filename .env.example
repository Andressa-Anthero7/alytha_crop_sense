# Credenciais OAuth do Sentinel Hub no Copernicus Data Space Ecosystem.
# Crie um OAuth client CDSE e copie os valores para o arquivo local .env (ignorado pelo Git).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Opcionais: sem chave, o mapa usa Leaflet/OpenStreetMap.
# A chave Maps e publica no navegador; restrinja os dominios autorizados.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# ID do projeto Google Cloud registrado no Earth Engine (nao e segredo).
GEE_PROJECT_ID=seu-project-id

# Opcional: token AgroAPI Embrapa SATVeg. Mantido somente no servidor.
EMBRAPA_ACCESS_TOKEN=

# Assistente OpenAI: a chave fica somente no servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
